# Mock works offline and is the default.
AI_PROVIDER=mock
GEMINI_MODEL=gemini-2.5-flash

# Gemini Developer API: set AI_PROVIDER=gemini and GOOGLE_API_KEY.
# GOOGLE_API_KEY=

# Vertex AI: set AI_PROVIDER=vertex and configure Application Default Credentials.
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# BigQuery additionally needs ADC with BigQuery read permissions and a project.